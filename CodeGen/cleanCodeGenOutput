#!/bin/bash
#  Delete the GENERATED code in CodeGen/.  Run from the repo root.
#  Everything removed here is rebuilt by the next solve.
#
#  The C++ is one directory per robot, CodeGen/Cpp/<Robot>CppCode/, and the
#  whole directory goes:  it holds generated headers as well as generated
#  .cpp files, and leaving a robot's FK header behind would let it be
#  included by the next robot's build.
#
#  Cpp_src/ IS NOT TOUCHED and must not be -- it is source, on the same
#  footing as LaTex_src/, and it lives outside CodeGen/ precisely so that
#  these lines cannot reach it.  The generated directories reach it by a
#  relative #include.
rm -f  CodeGen/Python/*.py
rm -rf CodeGen/Cpp/*CppCode
rm -f  CodeGen/Cpp/*.cpp CodeGen/Cpp/*.h
